#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=full_pipeline_lora_dora_vicuna
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=08:00:00
#SBATCH --output=/home/scur0168/fact-ai-group-23/reproduction/LoRA-DoRA_v2/FT-extension-datasets/full_pipeline_lora_dora_vicuna_%A.out
#SBATCH --error=/home/scur0168/fact-ai-group-23/reproduction/LoRA-DoRA_v2/FT-extension-datasets/full_pipeline_lora_dora_vicuna_%A.err
 

# Safety patch: make failures actionable
trap 'echo "[ERROR] Failed at line $LINENO: $BASH_COMMAND" >&2' ERR

module purge
module load 2025
module load Anaconda3/2025.06-1

# Initialize conda once so later activations work reliably
CONDA_ROOT="/sw/arch/RHEL9/EB_production/2025/software/Anaconda3/2025.06-1"
if [ -f "$CONDA_ROOT/etc/profile.d/conda.sh" ]; then
  # shellcheck disable=SC1091
  source "$CONDA_ROOT/etc/profile.d/conda.sh"
else
  echo "[ERROR] conda.sh not found at $CONDA_ROOT; aborting." >&2
  exit 1
fi

# =============================================================================
# PATHS
# =============================================================================
PROJECT_HOME="$HOME/fact-ai-group-23"
LLAMA_FACTORY_DIR="$PROJECT_HOME/LlamaFactory"
SRC_DIR="$PROJECT_HOME/src"

# Use scratch-shared for all checkpoints/adapters
SCRATCH_SHARED="${SCRATCH_SHARED:-/scratch-shared/$USER}"
[ -d "$SCRATCH_SHARED" ] || { echo "[ERROR] scratch-shared not found: $SCRATCH_SHARED" >&2; exit 1; }

EXT_ROOT="$SCRATCH_SHARED/fact-ai-group-23/extension"
RUN_ROOT="$EXT_ROOT/runs"
mkdir -p "$RUN_ROOT"

SAVES_ROOT="$RUN_ROOT/llamafactory_saves_safe_help"
ADAPTER_ROOT="$SAVES_ROOT/adapters"
MERGED_ROOT="$SAVES_ROOT/merged"
CFG_ROOT="$SAVES_ROOT/merge_cfgs"
METRICS_ROOT="$SAVES_ROOT/metrics"
mkdir -p "$ADAPTER_ROOT" "$MERGED_ROOT" "$CFG_ROOT" "$METRICS_ROOT"

LOG_DIR="/home/scur0168/fact-ai-group-23/reproduction/LoRA-DoRA_v2/FT-safe-datasets/logs"
mkdir -p "$LOG_DIR"

# =============================================================================
# DATASETS (SAFETY + HELPFULNESS)
# =============================================================================
SAFETY_DATASET="safety"
HELPFULNESS_DATASET="helpfulness_train"
COMBINED_DATASET="${SAFETY_DATASET},${HELPFULNESS_DATASET}"

# Evaluation dataset for helpfulness (Prometheus-2 judging)
HELPFULNESS_EVAL_DATASET="data/helpfulness_test.csv"

# =============================================================================
# PRE-FLIGHT CHECKS (safety patch)
# =============================================================================
echo "========================================"
echo "Preflight checks"
echo "Start time: $(date)"
echo "Scratch root: $RUN_ROOT"
echo "========================================"

# Disk space snapshot (helps debug mid-run failures)
df -h "$SCRATCH_SHARED" || true

# Check conda envs exist
conda info --envs | grep -q "Llama" || { echo "[ERROR] conda env Llama missing" >&2; exit 1; }
conda info --envs | grep -q "FACT" || { echo "[ERROR] conda env FACT missing" >&2; exit 1; }

# Check LlamaFactory exists
[ -d "$LLAMA_FACTORY_DIR" ] || { echo "[ERROR] LlamaFactory dir missing: $LLAMA_FACTORY_DIR" >&2; exit 1; }

# Check datasets are registered in LlamaFactory data config (common source of runtime failure)
DATASET_INFO="$LLAMA_FACTORY_DIR/data/dataset_info.json"
if [ -f "$DATASET_INFO" ]; then
  grep -q "\"$SAFETY_DATASET\"" "$DATASET_INFO" || echo "[WARN] $SAFETY_DATASET not found in $DATASET_INFO (verify dataset registration)."
  grep -q "\"$HELPFULNESS_DATASET\"" "$DATASET_INFO" || echo "[WARN] $HELPFULNESS_DATASET not found in $DATASET_INFO (verify dataset registration)."
else
  echo "[WARN] dataset_info.json not found at $DATASET_INFO (dataset resolution may fail depending on your setup)."
fi

# =============================================================================
# MODELS (Loop 2)
# =============================================================================
declare -A MODEL_PATH TEMPLATE MODEL_LABEL
MODEL_PATH[vicuna_7b]="lmsys/vicuna-7b-v1.5"
TEMPLATE[vicuna_7b]="vicuna"              # template for Vicuna
MODEL_LABEL[vicuna_7b]="vicuna-7b-v1.5"

MODELS=(vicuna_7b)

# =============================================================================
# METHODS (Loop 1)
# =============================================================================
# Use finetuning_type=lora for both; DoRA is enabled by --use_dora True
METHODS=(lora dora)

# =============================================================================
# PAPER HYPERPARAMETERS (Appendix F)
# These are the ones explicitly specified for LoRA/DoRA in the paper:
# epochs=3, AdamW (β1=0.9 β2=0.999 ε=1e-8 wd=0), lr=3e-4, batch=32,
# cosine decay, warmup ratio=0.1, r=8, alpha=16.
# =============================================================================
EPOCHS="3"
LR="3e-4"
BATCH_SIZE="32"
SCHEDULER="cosine"
WARMUP_RATIO="0.1"

OPTIM="adamw_torch"
ADAM_BETA1="0.9"
ADAM_BETA2="0.999"
ADAM_EPS="1e-8"
WEIGHT_DECAY="0.0"

LORA_RANK="8"
LORA_ALPHA="16"

# Settings not specified by the paper should fall back to LlamaFactory defaults.
# We therefore do NOT set (unless needed): cutoff_len, max_grad_norm, dropout, lora_target, flash_attn, packing, etc.

BF16="True"

# To keep "batch size = 32" unambiguous, do not use grad accumulation unless necessary
GRAD_ACC="1"

# Optional dry-run mode: set DRY_RUN=1 to skip heavy work and only create directories
DRY_RUN="${DRY_RUN:-0}"

# =============================================================================
# FUNCTIONS
# =============================================================================
train_model() {
  local method="$1"      # lora|dora
  local model_key="$2"   # vicuna_7b

  local model_path="${MODEL_PATH[$model_key]}"
  local template="${TEMPLATE[$model_key]}"

  local run_id
  run_id="$(date +%Y%m%d-%H%M%S)"

  local tag="${model_key}_${method}_safe_${run_id}"
  local out_dir="$ADAPTER_ROOT/$tag"

  echo ""
  echo "========== TRAIN: ${model_key} | ${method} =========="
  echo "Model:     $model_path"
  echo "Template:  $template"
  echo "Dataset:   $COMBINED_DATASET"
  echo "Adapter:   $out_dir"
  echo "HP: epochs=$EPOCHS lr=$LR bs=$BATCH_SIZE warmup=$WARMUP_RATIO r=$LORA_RANK alpha=$LORA_ALPHA"
  echo ""

  cd "$LLAMA_FACTORY_DIR"

  if [ "$DRY_RUN" = "1" ]; then
    mkdir -p "$out_dir"
    echo "[DRY RUN] Skipping training; created adapter dir: $out_dir"
    TRAIN_RESULT="$out_dir"
    return 0
  fi

  # Sanity check before training
  echo "[DEBUG] Verifying Llama environment..."
  conda run -n Llama bash -c "which python && python -V" || { echo "[ERROR] Llama environment verification failed" >&2; exit 1; }

  local dora_args=()
  if [ "$method" = "dora" ]; then
    dora_args+=( --use_dora True )
  fi

  conda run -n Llama python -m llamafactory.cli train \
    --stage sft \
    --do_train True \
    --model_name_or_path "$model_path" \
    --finetuning_type lora \
    --template "$template" \
    --trust_remote_code True \
    --dataset_dir data \
    --dataset "$COMBINED_DATASET" \
    --num_train_epochs "$EPOCHS" \
    --learning_rate "$LR" \
    --per_device_train_batch_size "$BATCH_SIZE" \
    --gradient_accumulation_steps "$GRAD_ACC" \
    --lr_scheduler_type "$SCHEDULER" \
    --warmup_ratio "$WARMUP_RATIO" \
    --optim "$OPTIM" \
    --adam_beta1 "$ADAM_BETA1" \
    --adam_beta2 "$ADAM_BETA2" \
    --adam_epsilon "$ADAM_EPS" \
    --weight_decay "$WEIGHT_DECAY" \
    --lora_rank "$LORA_RANK" \
    --lora_alpha "$LORA_ALPHA" \
    "${dora_args[@]}" \
    --bf16 "$BF16" \
    --report_to none \
    --output_dir "$out_dir"

  # Verify adapter directory was created
  if [ ! -d "$out_dir" ]; then
    echo "[ERROR] Training failed: adapter directory not created at $out_dir" >&2
    return 1
  fi

  TRAIN_RESULT="$out_dir"
}

merge_model() {
  local method="$1"
  local model_key="$2"
  local adapter_dir="$3"

  local base_model="${MODEL_PATH[$model_key]}"
  local template="${TEMPLATE[$model_key]}"

  local tag
  tag="$(basename "$adapter_dir")"

  local merged_dir="$MERGED_ROOT/${tag}_merged"
  local cfg="$CFG_ROOT/merge_${tag}.yaml"

  echo ""
  echo "========== MERGE: ${model_key} | ${method} =========="
  echo "Base:      $base_model"
  echo "Adapter:   $adapter_dir"
  echo "Merged:    $merged_dir"
  echo ""

  cd "$LLAMA_FACTORY_DIR"

  if [ "$DRY_RUN" = "1" ]; then
    mkdir -p "$merged_dir"
    mkdir -p "$CFG_ROOT"
    echo "[DRY RUN] Skipping merge; created merged dir: $merged_dir and cfg placeholder."
    MERGE_RESULT="$merged_dir"
    return 0
  fi

  # Sanity check before merge
  echo "[DEBUG] Verifying Llama environment..."
  conda run -n Llama bash -c "which python && python -V" || { echo "[ERROR] Llama environment verification failed" >&2; exit 1; }

  cat > "$cfg" << EOF
### model
model_name_or_path: $base_model
adapter_name_or_path: $adapter_dir
template: $template
trust_remote_code: true

### export
export_dir: $merged_dir
export_size: 5
export_device: cpu
export_legacy_format: false
EOF

  conda run -n Llama python -m llamafactory.cli export "$cfg"

  # Verify merged directory was created
  if [ ! -d "$merged_dir" ]; then
    echo "[ERROR] Merge failed: merged directory not created at $merged_dir" >&2
    return 1
  fi

  MERGE_RESULT="$merged_dir"
}

evaluate_model() {
  local method="$1"
  local model_key="$2"
  local merged_dir="$3"

  local model_label="${MODEL_LABEL[$model_key]}"
  local tag
  tag="$(basename "$merged_dir")"
  local metrics_dir="$METRICS_ROOT/$tag"
  mkdir -p "$metrics_dir"

  echo ""
  echo "========== EVAL: ${model_key} | ${method} =========="
  echo "Model label: $model_label"
  echo "Path:        $merged_dir"
  echo "Metrics:     $metrics_dir"
  echo ""

  cd "$SRC_DIR"

  if [ "$DRY_RUN" = "1" ]; then
    mkdir -p "$metrics_dir"
    echo "[DRY RUN] Skipping eval; created metrics dir: $metrics_dir"
    return 0
  fi

  # Sanity check before eval
  echo "[DEBUG] Verifying FACT environment..."
  conda run -n FACT bash -c "which python && python -V" || { echo "[ERROR] FACT environment verification failed" >&2; exit 1; }

  echo "[DEBUG] Running safety evaluation with model_label: $model_label"
  conda run -n FACT python eval_safety.py \
    --model "$model_label" \
    --model_path "$merged_dir" \
    --seed 0 \
    --category "safety" \
    >"$metrics_dir/safety.out" 2>"$metrics_dir/safety.err"

  echo "[DEBUG] Running helpfulness evaluation with dataset: $HELPFULNESS_EVAL_DATASET"
  conda run -n FACT python eval_run.py \
    --model_path "$merged_dir" \
    --dataset "$HELPFULNESS_EVAL_DATASET" \
    --seed 0 \
    >"$metrics_dir/helpfulness.out" 2>"$metrics_dir/helpfulness.err"
}

# =============================================================================
# MAIN LOOP
# =============================================================================
echo ""
echo "========================================"
echo "Pipeline: Train -> Merge -> Eval (SAFE)"
echo "Datasets: $COMBINED_DATASET"
echo "Start time: $(date)"
echo "Outputs:"
echo "  Adapters: $ADAPTER_ROOT"
echo "  Merged:   $MERGED_ROOT"
echo "  Metrics:  $METRICS_ROOT"
echo "========================================"

TRAIN_RESULT=""
MERGE_RESULT=""

for method in "${METHODS[@]}"; do
  for model_key in "${MODELS[@]}"; do
    TRAIN_RESULT=""
    train_model "$method" "$model_key"
    adapter_dir="$TRAIN_RESULT"
    [ -d "$adapter_dir" ] || { echo "[ERROR] adapter_dir missing: $adapter_dir" >&2; exit 1; }

    MERGE_RESULT=""
    merge_model "$method" "$model_key" "$adapter_dir"
    merged_dir="$MERGE_RESULT"
    [ -d "$merged_dir" ] || { echo "[ERROR] merged_dir missing: $merged_dir" >&2; exit 1; }

    evaluate_model "$method" "$model_key" "$merged_dir"
  done
done

echo ""
echo "========================================"
echo "All runs completed."
echo "End time: $(date)"
echo "Scratch usage:"
du -sh "$SAVES_ROOT" || true
echo "========================================"
