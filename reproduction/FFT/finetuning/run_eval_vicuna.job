#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=FFT_Vic_eval
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=00:50:00
#SBATCH --output=reproduction/FFT/FFT_Vicuna_eval_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/fact-ai-group-23/src/

source activate FACT

SCOREDIR="/scratch-shared/scur0168/significance_score"
MODEL_LABEL="vicuna-7b-v1.5"
MODEL_PATH="/scratch-shared/scur0168/FFT/Vicuna-7B-v1.5/full/merged/"
NSAMPLES=128
SEED=0

# Origin evaluation only (no SPIN, no importance scores)
srun python eval_origin.py \
  --model ${MODEL_LABEL} \
  --model_path ${MODEL_PATH} \
  --seed ${SEED}