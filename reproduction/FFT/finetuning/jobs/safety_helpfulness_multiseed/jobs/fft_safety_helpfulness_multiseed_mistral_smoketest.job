#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=00:45:00
#SBATCH --job-name=FFT_Mistral_SafetyHelpful_SmokeTest
#SBATCH --output=/home/aramautar1/fact-ai-group-23/reproduction/FFT/finetuning/jobs/safety_helpfulness_multiseed/outputs/fft_mistral_safety_helpfulness_smoketest_%A.out

# See fft_safety_helpfulness_multiseed_qwen_smoketest.job for full rationale --
# identical structure, Mistral-7B-Instruct-v0.2 in place of Qwen.

set -uo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

CONDA_ROOT="/sw/arch/RHEL9/EB_production/2025/software/Anaconda3/2025.06-1"
source "$CONDA_ROOT/etc/profile.d/conda.sh"

SEED=0

SCRATCH_SHARED="/scratch-shared/${USER}"
OUT_DIR="${SCRATCH_SHARED}/FFT/Mistral-7b-Instruct/full_safety_helpfulness/smoketest_seed${SEED}"
EVAL_OUT_BASE="$HOME/fact-ai-group-23/src/jobs/safety_helpfulness_paired/outputs/fft_mistral_safety_helpfulness_smoketest/seed_${SEED}"
mkdir -p "${OUT_DIR}" "${EVAL_OUT_BASE}"

LOCKFILE="/scratch-shared/${USER}/.hf_cache_lock_mistral-7b-instruct-v0.2"
(
  flock -x 200
  conda run -n LlFactory python -c "
from huggingface_hub import snapshot_download
snapshot_download('mistralai/Mistral-7B-Instruct-v0.2')
"
) 200>"${LOCKFILE}"

cd $HOME/fact-ai-group-23/LlamaFactory/

conda run -n LlFactory --no-capture-output python -m llamafactory.cli train \
  --stage sft \
  --do_train True \
  --model_name_or_path mistralai/Mistral-7B-Instruct-v0.2 \
  --preprocessing_num_workers 16 \
  --finetuning_type full \
  --template mistral \
  --flash_attn auto \
  --dataset_dir data \
  --dataset safety,helpfulness_train \
  --cutoff_len 128 \
  --learning_rate 5e-06 \
  --num_train_epochs 1 \
  --max_samples 4 \
  --per_device_train_batch_size 1 \
  --gradient_accumulation_steps 1 \
  --lr_scheduler_type constant \
  --logging_steps 1 \
  --save_steps 1000 \
  --packing False \
  --enable_thinking False \
  --report_to none \
  --output_dir "${OUT_DIR}" \
  --bf16 True \
  --trust_remote_code True \
  --optim adamw_bnb_8bit \
  --seed ${SEED}

TRAIN_STATUS=$?
echo "TRAIN_EXIT_CODE: ${TRAIN_STATUS}"

SNAPSHOT_DIR="$(conda run -n LlFactory python -c "
from huggingface_hub import snapshot_download
print(snapshot_download('mistralai/Mistral-7B-Instruct-v0.2', allow_patterns=['tokenizer*','vocab*','merges*','special_tokens_map.json','added_tokens.json','chat_template*'], local_files_only=True))
")"
cp -f "${SNAPSHOT_DIR}"/tokenizer* "${OUT_DIR}/" 2>/dev/null || true
cp -f "${SNAPSHOT_DIR}"/vocab* "${OUT_DIR}/" 2>/dev/null || true
cp -f "${SNAPSHOT_DIR}"/merges* "${OUT_DIR}/" 2>/dev/null || true
cp -f "${SNAPSHOT_DIR}"/special_tokens_map.json "${OUT_DIR}/" 2>/dev/null || true
cp -f "${SNAPSHOT_DIR}"/added_tokens.json "${OUT_DIR}/" 2>/dev/null || true
cp -f "${SNAPSHOT_DIR}"/chat_template* "${OUT_DIR}/" 2>/dev/null || true
echo "[INFO] Restored original tokenizer files from ${SNAPSHOT_DIR} into ${OUT_DIR}"

cd $HOME/fact-ai-group-23/src/

EVAL_STATUS=0
for DATASET_NAME in safety_test helpfulness_test; do
  EVAL_OUT_DIR="${EVAL_OUT_BASE}/${DATASET_NAME}"
  mkdir -p "${EVAL_OUT_DIR}"

  conda run -n FACT --no-capture-output python eval_safety_helpfulness_paired.py \
    --model_path "${OUT_DIR}" \
    --dataset "$HOME/fact-ai-group-23/src/data/${DATASET_NAME}.csv" \
    --max_samples 8 \
    --out_dir "${EVAL_OUT_DIR}" \
    --seed ${SEED} \
  | tee "${EVAL_OUT_DIR}/run.log"
  ds_status=${PIPESTATUS[0]}
  [ "$ds_status" -eq 0 ] || EVAL_STATUS=$ds_status

  echo "[INFO] $(date '+%H:%M:%S') dataset=${DATASET_NAME} exit=${ds_status}. Results: ${EVAL_OUT_DIR}/paired_results.csv"
done
echo "EVAL_EXIT_CODE: ${EVAL_STATUS}"

if [ "$TRAIN_STATUS" -eq 0 ] && [ "$EVAL_STATUS" -eq 0 ]; then
  echo "SMOKE_TEST_RESULT: PASS"
else
  echo "SMOKE_TEST_RESULT: FAIL (train=${TRAIN_STATUS} eval=${EVAL_STATUS})"
fi
rm -rf "${OUT_DIR}"
