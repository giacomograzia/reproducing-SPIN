#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=FFT_Vicuna_MultiSeed
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=24:00:00
#SBATCH --array=0-2
#SBATCH --output=/home/aramautar1/fact-ai-group-23/reproduction/FFT/finetuning/jobs/multiseed/outputs/fft_vicuna_multiseed_%A_%a.out

set -euo pipefail
trap 'echo "[ERROR] Failed at line $LINENO: $BASH_COMMAND" >&2' ERR

module purge
module load 2025
module load Anaconda3/2025.06-1

# See full_fine_tuning_qwen_multiseed.job for why this uses `conda run -n`
# instead of `source activate`: switching envs twice in one shell corrupts
# PATH/PYTHONPATH and silently breaks the second env (confirmed via smoke
# test: eval crashed with "ModuleNotFoundError: No module named 'vllm'").
CONDA_ROOT="/sw/arch/RHEL9/EB_production/2025/software/Anaconda3/2025.06-1"
source "$CONDA_ROOT/etc/profile.d/conda.sh"

SEED=$SLURM_ARRAY_TASK_ID

SCRATCH_SHARED="/scratch-shared/${USER}"
OUT_DIR="${SCRATCH_SHARED}/FFT/Vicuna-7B-v1.5/full/seed${SEED}"
LOGDIR="$HOME/fact-ai-group-23/reproduction/FFT/finetuning/logs"
mkdir -p "${LOGDIR}" "${OUT_DIR}"

# Item-level (per-prompt) labels for Table 1's SPIN-vs-baseline significance
# test -- see reproduction/figures_and_tables/baselines-table-1/item_level_stats.py.
LABELS_OUT_DIR="$HOME/fact-ai-group-23/reproduction/figures_and_tables/baselines-table-1/item_level_labels/fft_vicuna/seed_${SEED}"
mkdir -p "${LABELS_OUT_DIR}"

# Pre-warm the HF cache -- see full_fine_tuning_qwen_multiseed.job for why.
# This one matters especially for Vicuna: it's the model that actually hit
# this exact race in Origin/SPIN's real runs.
LOCKFILE="/scratch-shared/${USER}/.hf_cache_lock_vicuna-7b-v1.5"
(
  flock -x 200
  conda run -n LlFactory python -c "
from huggingface_hub import snapshot_download
snapshot_download('lmsys/vicuna-7b-v1.5')
"
) 200>"${LOCKFILE}"

# NOTE: the original full_fine_tuning_vicuna.job used `--max_samples 2` and
# `source activate Llama` (instead of LlFactory) — both look like leftover
# smoke-test values rather than the real run config. This script uses
# max_samples=100000 and env LlFactory, matching the qwen/mistral FFT jobs.
# Double-check both against whatever actually produced the Table 1 numbers
# before submitting.

# ---- Train (full fine-tune) ----
cd $HOME/fact-ai-group-23/LlamaFactory/

# Skip already-finished training entirely, rather than letting LlamaFactory
# auto-resume from a leftover checkpoint dir (checkpoint-375/checkpoint-750
# left over from an earlier completed run). Without --overwrite_output_dir,
# `llamafactory.cli train --do_train True` on an output_dir that already has
# a checkpoint auto-resumes from it -- which crashed the LoRA/DoRA safe-
# datasets multiseed job with an incompatible saved AMP-scaler state on a
# run that had already finished (see that job's train_model() for the full
# writeup). Same risk here since ${OUT_DIR} already has a final
# model.safetensors AND leftover checkpoint dirs from a prior run.
if [ -f "${OUT_DIR}/model.safetensors" ]; then
  echo "[SKIP] Already trained: ${OUT_DIR} (found model.safetensors)"
else

conda run -n LlFactory --no-capture-output python -m llamafactory.cli train \
  --stage sft \
  --do_train True \
  --model_name_or_path lmsys/vicuna-7b-v1.5 \
  --preprocessing_num_workers 16 \
  --finetuning_type full \
  --template vicuna \
  --flash_attn auto \
  --dataset_dir data \
  --dataset beaver_train330k_privacy_safe_1k,beaver_train330k_fairness_safe_1k \
  --cutoff_len 2048 \
  --learning_rate 5e-06 \
  --num_train_epochs 3.0 \
  --max_samples 100000 \
  --per_device_train_batch_size 2 \
  --gradient_accumulation_steps 8 \
  --lr_scheduler_type cosine \
  --max_grad_norm 1.0 \
  --logging_steps 5 \
  --warmup_ratio 0.1 \
  --adam_beta1 0.9 \
  --adam_beta2 0.999 \
  --adam_epsilon 1e-8 \
  --weight_decay 0.0 \
  --packing False \
  --enable_thinking True \
  --push_to_hub False \
  --report_to none \
  --output_dir "${OUT_DIR}" \
  --bf16 True \
  --plot_loss True \
  --trust_remote_code True \
  --ddp_timeout 180000000 \
  --include_num_input_tok True \
  --optim adamw_bnb_8bit \
  --save_steps 1000 \
  --seed ${SEED}

fi

# ---- Fix tokenizer ----
# Unlike Qwen/Mistral, lmsys/vicuna-7b-v1.5's HF repo ships NO tokenizer.json
# at all (only the legacy SentencePiece tokenizer.model -- Vicuna predates
# the fast-tokenizer-file convention). So there is no "original" tokenizer.json
# to restore: LlFactory's training step auto-GENERATED one locally using its
# newer `tokenizers` library, and that generated file is what FACT's older
# `tokenizers` can't parse ("data did not match any variant of untagged enum
# ModelWrapper" -- confirmed via real run). Fix: delete the generated file so
# FACT rebuilds a compatible fast tokenizer from tokenizer.model at load time.
#
# IMPORTANT: don't assume tokenizer.model survives in ${OUT_DIR} on its own --
# confirmed via smoke test that a short/tiny training run can finish without
# tokenizer.model ever being copied there, which then crashes the slow-
# tokenizer fallback with "TypeError: not a string" (SentencePiece handed a
# None path). So explicitly copy tokenizer.model (+ its config files) from
# the pristine HF snapshot too, rather than relying on what training left
# behind. Confirmed working end-to-end (reloads fine, vocab size 32000).
SNAPSHOT_DIR_SLOW="$(conda run -n LlFactory python -c "
from huggingface_hub import snapshot_download
print(snapshot_download('lmsys/vicuna-7b-v1.5', allow_patterns=['tokenizer.model','tokenizer_config.json','special_tokens_map.json'], local_files_only=True))
")"
rm -f "${OUT_DIR}/tokenizer.json"
cp -f "${SNAPSHOT_DIR_SLOW}/tokenizer.model" "${OUT_DIR}/" 2>/dev/null || true
cp -f "${SNAPSHOT_DIR_SLOW}/tokenizer_config.json" "${OUT_DIR}/" 2>/dev/null || true
cp -f "${SNAPSHOT_DIR_SLOW}/special_tokens_map.json" "${OUT_DIR}/" 2>/dev/null || true
echo "[INFO] Removed LlFactory-generated tokenizer.json and restored tokenizer.model/config from ${SNAPSHOT_DIR_SLOW} into ${OUT_DIR}"

# ---- Eval ----
cd $HOME/fact-ai-group-23/src/

conda run -n FACT --no-capture-output python eval_origin.py \
  --model vicuna-7b-v1.5 \
  --model_path "${OUT_DIR}" \
  --seed ${SEED} \
  --labels_out_dir "${LABELS_OUT_DIR}" \
| tee "${LOGDIR}/fft_eval_vicuna_seed${SEED}.log"
