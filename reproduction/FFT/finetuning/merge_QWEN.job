#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=Merge_Qwen_FFT
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=02:00:00
#SBATCH --output=reproduction/FFT/slurm_output_merge_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/fact-ai-group-23/LlamaFactory/
source activate LlFactory

python -m llamafactory.cli export saves/FFT/merge_qwen_fft.yaml