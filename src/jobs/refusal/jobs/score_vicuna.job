#!/bin/bash

#SBATCH --partition=staging
#SBATCH --job-name=Refusal_ScoreVicuna
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --time=00:10:00
#SBATCH --output=/home/aramautar1/fact-ai-group-23/src/jobs/refusal/outputs/Refusal_ScoreVicuna_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1
source activate FACT
set -euo pipefail
cd $HOME/fact-ai-group-23/reproduction/general_capabilities

python score_refusal.py --benchmarks xstest or_bench \
  --model_ids origin_vicuna-7b-v1.5 spin_seed0_vicuna-7b-v1.5
