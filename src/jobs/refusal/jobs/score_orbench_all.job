#!/bin/bash

#SBATCH --partition=staging
#SBATCH --job-name=Refusal_ScoreORBenchAll
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --time=00:10:00
#SBATCH --output=/home/aramautar1/fact-ai-group-23/src/jobs/refusal/outputs/Refusal_ScoreORBenchAll_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1
source activate FACT
set -euo pipefail
cd $HOME/fact-ai-group-23/reproduction/general_capabilities

python score_refusal.py --benchmarks or_bench \
  --model_ids origin_qwen2-7b-instruct spin_seed0_qwen2-7b-instruct \
              origin_mistral-7b-instruct-v0.2 spin_seed0_mistral-7b-instruct-v0.2 \
              origin_vicuna-7b-v1.5 spin_seed0_vicuna-7b-v1.5
