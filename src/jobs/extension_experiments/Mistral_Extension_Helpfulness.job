#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=Mistral_Extension_Helpfulness
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=06:00:00
#SBATCH --output=Mistral_Extension_Helpfulness_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/fact-ai-group-23/src/"

source activate FACTvllm

MODEL_LABEL="mistral-7b-instruct-v0.2"
MODEL_PATH="mistralai/Mistral-7B-Instruct-v0.2"
SEED=0

srun python -u eval_run.py \
  --model_path "${MODEL_PATH}" \
  --dataset "data/helpfulness_test.csv" \
  --seed "${SEED}"