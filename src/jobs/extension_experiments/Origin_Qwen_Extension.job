#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=Origin_Qwen_Extension
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=06:00:00
#SBATCH --output=Origin_Qwen_Extension_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/fact-ai-group-23/src/

source activate FACT


# Run your code

MODEL_LABEL="qwen2-7b-instruct"
MODEL_PATH="Qwen/Qwen2-7B-Instruct"
SEED=0
CATEGORY="safety"

# Origin evaluation only (no SPIN, no importance scores)
srun python eval_safety.py \
  --model ${MODEL_LABEL} \
  --model_path ${MODEL_PATH} \
  --seed ${SEED} \
  --category ${CATEGORY} 