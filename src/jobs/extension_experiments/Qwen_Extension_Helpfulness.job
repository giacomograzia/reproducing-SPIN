#!/bin/bash
#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=Qwen_Extension_Helpfulness
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=06:00:00
#SBATCH --output=Qwen_Extension_Helpfulness_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$HOME/fact-ai-group-23/src/"

source activate FACT

MODEL_LABEL="qwen2-7b-instruct"
MODEL_PATH="Qwen/Qwen2-7B-Instruct"
SEED=0

srun python -u eval_run.py \
  --model_path "${MODEL_PATH}" \
  --dataset "data/helpfulness_test.csv" \
  --seed "${SEED}"