#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=run_spin_mistral_extension
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=06:00:00
#SBATCH --output=run_spin_mistral_extension_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/fact-ai-group-23/src/

source activate FACT


# Run your code

SCOREDIR="/scratch-shared/scur0168/extension/significance_score"
MODELDIR="/scratch-shared/scur0168/extension/models"
MODEL_LABEL="mistral-7b-instruct-v0.2"
MODEL_PATH="mistralai/Mistral-7B-Instruct-v0.2"
NSAMPLES=128
SEED=0

# 1) Compute importance scores (general + safety + helpfulness)
srun python compute_importance_score.py \
  --model "${MODEL_LABEL}" \
  --model_path "${MODEL_PATH}" \
  --dataset alpaca_cleaned_no_safety \
  --nsamples ${NSAMPLES} \
  --seed ${SEED} \
  --score_dir ${SCOREDIR}

srun python compute_importance_score.py \
  --model "${MODEL_LABEL}" \
  --model_path "${MODEL_PATH}" \
  --dataset safety \
  --nsamples ${NSAMPLES} \
  --seed ${SEED} \
  --score_dir ${SCOREDIR}

srun python compute_importance_score.py \
  --model "${MODEL_LABEL}" \
  --model_path "${MODEL_PATH}" \
  --dataset helpfulness_train \
  --nsamples ${NSAMPLES} \
  --seed ${SEED} \
  --score_dir ${SCOREDIR}

# 2) SPIN + run evaluation (like in main.py)
srun python main.py \
  --model "${MODEL_LABEL}" \
  --model_path "${MODEL_PATH}" \
  --dataset1 safety \
  --dataset2 helpfulness_train \
  --target_module mlp \
  --p 5e-7 \
  --q 5e-7 \
  --nsamples ${NSAMPLES} \
  --seed ${SEED} \
  --score_dir ${SCOREDIR} \
  --model_dir ${MODELDIR}
