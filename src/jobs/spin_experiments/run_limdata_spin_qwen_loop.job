#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=Lim_Data_Spin_Qwen
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=06:00:00
#SBATCH --output=Loop_Lim_Data_Spin_Qwen_%A.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/fact-ai-group-23/src/

source activate FACT


# Run your code

SCOREDIR="/scratch-shared/scur0168/significance_score"
MODEL_LABEL="qwen2-7b-instruct"
MODEL_PATH="Qwen/Qwen2-7B-Instruct"
NSAMPLES=128 
SEED=0

SIZES=(600 400 200 100 75 50 25 10 5 4 3 2 1)

# Compute importance scores (general + privacy + fairness)
srun python compute_importance_score.py \
  --model "${MODEL_LABEL}" \
  --model_path "${MODEL_PATH}" \
  --dataset alpaca_cleaned_no_safety \
  --nsamples ${NSAMPLES} \
  --seed ${SEED} \
  --score_dir ${SCOREDIR}


# Loop for limited data experiment
for DATASET_NSAMPLES in ${SIZES[@]}; do

  srun python compute_importance_score.py \
    --model "${MODEL_LABEL}" \
    --model_path "${MODEL_PATH}" \
    --dataset beaver_train330k_privacy_safe_1k \
    --nsamples ${DATASET_NSAMPLES} \
    --seed ${SEED} \
    --score_dir ${SCOREDIR}

  srun python compute_importance_score.py \
    --model "${MODEL_LABEL}" \
    --model_path "${MODEL_PATH}" \
    --dataset beaver_train330k_fairness_safe_1k \
    --nsamples ${DATASET_NSAMPLES} \
    --seed ${SEED} \
    --score_dir ${SCOREDIR}


  # keep a log per dataset size so we can summarize at the end
  srun python main.py \
    --model "${MODEL_LABEL}" \
    --model_path "${MODEL_PATH}" \
    --dataset1 beaver_train330k_privacy_safe_1k \
    --dataset2 beaver_train330k_fairness_safe_1k \
    --target_module mlp \
    --p 5e-7 \
    --q 5e-7 \
    --nsamples ${NSAMPLES} \
    --dataset_nsamples ${DATASET_NSAMPLES} \
    --seed ${SEED} \
    --score_dir ${SCOREDIR} \
  | tee "spin_eval_${DATASET_NSAMPLES}.log"

done


# Print summary at the end
echo "===================== SUMMARY (trustworthy results) ====================="
for DATASET_NSAMPLES in ${SIZES[@]}; do
  echo "[DATASET_NSAMPLES=${DATASET_NSAMPLES}]"
  awk '
  /trustworthy results here/ {flag=1; next}
  flag==1 && $0 ~ /^\{/ {print; exit}
' "spin_eval_${DATASET_NSAMPLES}.log"
done
echo "========================================================================="
