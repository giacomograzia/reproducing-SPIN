#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=SmokeTest_Spin
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=01:30:00
#SBATCH --output=SmokeTest_Spin_%A.out

# Smoke test for run_limdata_spin_qwen_multiseed.job
# Runs the full pipeline with nsamples=2 and a single tiny dataset size (N=2).
# Importance score steps finish in seconds; only MD-Judge (~20 min) takes real time.
# If this completes cleanly the full array job is safe to submit.

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/fact-ai-group-23/src/

source activate FACT

export HF_HOME=/scratch-shared/aramautar1/hf_cache

SEED=0
SCOREDIR="${TMPDIR}/significance_score/seed_${SEED}"
MODEL_LABEL="qwen2-7b-instruct"
MODEL_PATH="Qwen/Qwen2-7B-Instruct"
NSAMPLES=2          # tiny — importance score steps finish in seconds
SIZES=(2)           # single size, also tiny

LOGDIR="$HOME/fact-ai-group-23/src/multiseed_logs"
mkdir -p "${LOGDIR}"

log() { echo "[$(date '+%H:%M:%S')] SMOKE seed=${SEED} $*"; }

log "START smoke test"

log "Computing Alpaca general importance scores (nsamples=${NSAMPLES})"
srun python compute_importance_score.py \
  --model "${MODEL_LABEL}" \
  --model_path "${MODEL_PATH}" \
  --dataset alpaca_cleaned_no_safety \
  --nsamples ${NSAMPLES} \
  --seed ${SEED} \
  --score_dir ${SCOREDIR}
log "Alpaca scores done"

for DATASET_NSAMPLES in ${SIZES[@]}; do

  MODEL_SAVE_DIR="${TMPDIR}/spin_models/seed${SEED}_N${DATASET_NSAMPLES}"

  log "N=${DATASET_NSAMPLES} (1/3) privacy importance scores"
  srun python compute_importance_score.py \
    --model "${MODEL_LABEL}" \
    --model_path "${MODEL_PATH}" \
    --dataset beaver_train330k_privacy_safe_1k \
    --nsamples ${DATASET_NSAMPLES} \
    --seed ${SEED} \
    --score_dir ${SCOREDIR}

  log "N=${DATASET_NSAMPLES} (2/3) fairness importance scores"
  srun python compute_importance_score.py \
    --model "${MODEL_LABEL}" \
    --model_path "${MODEL_PATH}" \
    --dataset beaver_train330k_fairness_safe_1k \
    --nsamples ${DATASET_NSAMPLES} \
    --seed ${SEED} \
    --score_dir ${SCOREDIR}

  log "N=${DATASET_NSAMPLES} (3/3) SPIN + evaluation (MD-Judge takes ~20 min)"
  python main.py \
    --model "${MODEL_LABEL}" \
    --model_path "${MODEL_PATH}" \
    --dataset1 beaver_train330k_privacy_safe_1k \
    --dataset2 beaver_train330k_fairness_safe_1k \
    --target_module mlp \
    --p 5e-7 \
    --q 5e-7 \
    --nsamples ${NSAMPLES} \
    --dataset_nsamples ${DATASET_NSAMPLES} \
    --seed ${SEED} \
    --score_dir ${SCOREDIR} \
    --model_dir "${MODEL_SAVE_DIR}" \
  | tee "${LOGDIR}/spin_eval_${DATASET_NSAMPLES}_seed${SEED}_smoketest.log"

  rm -rf "${MODEL_SAVE_DIR}"
  rm -rf "${SCOREDIR}/importance/${DATASET_NSAMPLES}"

  log "DONE N=${DATASET_NSAMPLES}"

done

log "Smoke test PASSED — check ${LOGDIR}/spin_eval_2_seed0_smoketest.log for results"
