#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=LimData_Spin_MultiSeed
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=08:00:00
#SBATCH --array=0-4
#SBATCH --output=LimData_Spin_MultiSeed_%A_%a.out

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/fact-ai-group-23/src/

source activate FACT

# Cache HuggingFace models in scratch-shared so they persist across jobs
# and don't count against home quota (~15 GB Qwen + a few GB MD-Judge).
# Create the folder once before your first job run:
#   mkdir -p /scratch-shared/aramautar1/hf_cache
export HF_HOME=/scratch-shared/aramautar1/hf_cache

# Each array task is one seed (0-4). $TMPDIR is a job-private folder on
# /scratch-local (backed by 1.9 PB GPFS, auto-cleaned after the job).
# No special permissions needed and no manual cleanup required.
#
# Alternative if you prefer persistent scratch:
#   mkdir -p /scratch-shared/aramautar1/spin_multiseed
#   SCOREDIR="/scratch-shared/aramautar1/spin_multiseed/significance_score/seed_${SEED}"
#   MODEL_SAVE_DIR="/scratch-shared/aramautar1/spin_multiseed/models/seed${SEED}_N${DATASET_NSAMPLES}"

SEED=$SLURM_ARRAY_TASK_ID
SCOREDIR="${TMPDIR}/significance_score/seed_${SEED}"
MODEL_LABEL="qwen2-7b-instruct"
MODEL_PATH="Qwen/Qwen2-7B-Instruct"
NSAMPLES=128

# Log files land in a persistent directory so they survive after the job
LOGDIR="$HOME/fact-ai-group-23/src/multiseed_logs"
mkdir -p "${LOGDIR}"

SIZES=(600 400 200 100 75 50 25 10)

log() { echo "[$(date '+%H:%M:%S')] seed=${SEED} $*"; }

log "START — seed=${SEED}, sizes=${SIZES[*]}"

# ── Helper: check whether a size is already done ──────────────────────────────
# A log file is "done" if it contains the results line (survives a job kill mid-run).
# This makes re-submitting the same array task safe: completed sizes are skipped.
already_done() {
  local logfile="${LOGDIR}/spin_eval_${1}_seed${SEED}.log"
  [[ -f "$logfile" ]] && grep -q "trustworthy results here" "$logfile"
}

# ── General importance scores (Alpaca, seed-specific 128-sample subsample) ────
# Always re-run: $TMPDIR is wiped between jobs so scores are never cached.
log "Computing Alpaca general importance scores (nsamples=${NSAMPLES})"
srun python compute_importance_score.py \
  --model "${MODEL_LABEL}" \
  --model_path "${MODEL_PATH}" \
  --dataset alpaca_cleaned_no_safety \
  --nsamples ${NSAMPLES} \
  --seed ${SEED} \
  --score_dir ${SCOREDIR}
log "Alpaca scores done"

# ── Loop over dataset sizes ────────────────────────────────────────────────────
for DATASET_NSAMPLES in ${SIZES[@]}; do

  if already_done ${DATASET_NSAMPLES}; then
    log "SKIP N=${DATASET_NSAMPLES} — log already contains results"
    continue
  fi

  log "START N=${DATASET_NSAMPLES} (1/3) computing privacy importance scores"
  MODEL_SAVE_DIR="${TMPDIR}/spin_models/seed${SEED}_N${DATASET_NSAMPLES}"

  srun python compute_importance_score.py \
    --model "${MODEL_LABEL}" \
    --model_path "${MODEL_PATH}" \
    --dataset beaver_train330k_privacy_safe_1k \
    --nsamples ${DATASET_NSAMPLES} \
    --seed ${SEED} \
    --score_dir ${SCOREDIR}

  log "N=${DATASET_NSAMPLES} (2/3) computing fairness importance scores"
  srun python compute_importance_score.py \
    --model "${MODEL_LABEL}" \
    --model_path "${MODEL_PATH}" \
    --dataset beaver_train330k_fairness_safe_1k \
    --nsamples ${DATASET_NSAMPLES} \
    --seed ${SEED} \
    --score_dir ${SCOREDIR}

  log "N=${DATASET_NSAMPLES} (3/3) running SPIN + evaluation"
  python main.py \
    --model "${MODEL_LABEL}" \
    --model_path "${MODEL_PATH}" \
    --dataset1 beaver_train330k_privacy_safe_1k \
    --dataset2 beaver_train330k_fairness_safe_1k \
    --target_module mlp \
    --p 5e-7 \
    --q 5e-7 \
    --nsamples ${NSAMPLES} \
    --dataset_nsamples ${DATASET_NSAMPLES} \
    --seed ${SEED} \
    --score_dir ${SCOREDIR} \
    --model_dir "${MODEL_SAVE_DIR}" \
  | tee "${LOGDIR}/spin_eval_${DATASET_NSAMPLES}_seed${SEED}.log"

  # Free ~14 GB (saved model) and ~60 GB (dataset score pkl files)
  rm -rf "${MODEL_SAVE_DIR}"
  rm -rf "${SCOREDIR}/importance/${DATASET_NSAMPLES}"

  log "DONE N=${DATASET_NSAMPLES}"

done

echo "===================== SUMMARY seed=${SEED} ====================="
for DATASET_NSAMPLES in ${SIZES[@]}; do
  echo "[N=${DATASET_NSAMPLES} seed=${SEED}]"
  awk '
  /trustworthy results here/ {flag=1; next}
  flag==1 && $0 ~ /^\{/ {print; exit}
' "${LOGDIR}/spin_eval_${DATASET_NSAMPLES}_seed${SEED}.log"
done
echo "================================================================="
log "ALL DONE"
