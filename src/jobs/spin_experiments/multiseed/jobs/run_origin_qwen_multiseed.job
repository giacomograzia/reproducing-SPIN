#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=Origin_Qwen_MultiSeed
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=24:00:00
#SBATCH --array=0-2
#SBATCH --output=/home/aramautar1/fact-ai-group-23/src/jobs/spin_experiments/multiseed/outputs/Origin_Qwen_MultiSeed_%A_%a.out

# One array task per seed (0-2). Origin has no training step, so each task
# is just a single evaluation run — cheap relative to SPIN/FFT/LoRA-DoRA.

set -euo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/fact-ai-group-23/src/

source activate FACT

SEED=$SLURM_ARRAY_TASK_ID
MODEL_LABEL="qwen2-7b-instruct"
MODEL_PATH="Qwen/Qwen2-7B-Instruct"

LOGDIR="$HOME/fact-ai-group-23/src/multiseed_logs/origin_qwen"
mkdir -p "${LOGDIR}"

# Item-level (per-prompt) labels for Table 1's SPIN-vs-baseline significance
# test -- see reproduction/figures_and_tables/baselines-table-1/item_level_stats.py.
LABELS_OUT_DIR="$HOME/fact-ai-group-23/reproduction/figures_and_tables/baselines-table-1/item_level_labels/origin_qwen/seed_${SEED}"
mkdir -p "${LABELS_OUT_DIR}"

# Pre-warm the HF cache before any array task tries to load the model.
# Without this, all 3 seeds launch simultaneously and race on downloading
# the same not-yet-cached blob, corrupting each other's partial downloads
# (this is exactly what took down Origin Vicuna's real run). flock
# serializes the 3 tasks on this one download.
LOCKFILE="/scratch-shared/${USER}/.hf_cache_lock_${MODEL_LABEL}"
(
  flock -x 200
  python -c "
from huggingface_hub import snapshot_download
snapshot_download('${MODEL_PATH}')
"
) 200>"${LOCKFILE}"

# Origin evaluation only (no SPIN, no importance scores)
srun python eval_origin.py \
  --model ${MODEL_LABEL} \
  --model_path ${MODEL_PATH} \
  --seed ${SEED} \
  --labels_out_dir "${LABELS_OUT_DIR}" \
| tee "${LOGDIR}/origin_eval_seed${SEED}.log"
