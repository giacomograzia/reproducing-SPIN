#!/bin/bash

#SBATCH --partition=gpu_h100
#SBATCH --gpus=1
#SBATCH --job-name=Spin_Mistral_MultiSeed
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=24:00:00
#SBATCH --array=1
#SBATCH --output=/home/aramautar1/fact-ai-group-23/src/jobs/spin_experiments/multiseed/outputs/Spin_Mistral_MultiSeed_%A_%a.out

set -euo pipefail

module purge
module load 2025
module load Anaconda3/2025.06-1

cd $HOME/fact-ai-group-23/src/

source activate FACT

export HF_HOME=/scratch-shared/aramautar1/hf_cache

SEED=$SLURM_ARRAY_TASK_ID
SCOREDIR="${TMPDIR}/significance_score/seed_${SEED}"
MODELDIR="${TMPDIR}/spin_models/seed_${SEED}"
MODEL_LABEL="mistral-7b-instruct-v0.2"
MODEL_PATH="mistralai/Mistral-7B-Instruct-v0.2"
NSAMPLES=128

LOGDIR="$HOME/fact-ai-group-23/src/multiseed_logs/spin_mistral"
mkdir -p "${LOGDIR}"

# Item-level (per-prompt) labels for Table 1's SPIN-vs-baseline significance
# test -- see reproduction/figures_and_tables/baselines-table-1/item_level_stats.py.
LABELS_OUT_DIR="$HOME/fact-ai-group-23/reproduction/figures_and_tables/baselines-table-1/item_level_labels/spin_mistral/seed_${SEED}"
mkdir -p "${LABELS_OUT_DIR}"

log() { echo "[$(date '+%H:%M:%S')] seed=${SEED} $*"; }

# Pre-warm the HF cache before any array task tries to load the model.
# See run_spin_qwen_multiseed.job for why: concurrent seeds racing on a
# not-yet-cached download corrupt each other's partial downloads.
LOCKFILE="/scratch-shared/${USER}/.hf_cache_lock_${MODEL_LABEL}"
(
  flock -x 200
  python -c "
from huggingface_hub import snapshot_download
snapshot_download('${MODEL_PATH}')
"
) 200>"${LOCKFILE}"
log "Cache pre-warm complete for ${MODEL_PATH}"

log "Computing Alpaca general importance scores"
srun python compute_importance_score.py \
  --model "${MODEL_LABEL}" \
  --model_path "${MODEL_PATH}" \
  --dataset alpaca_cleaned_no_safety \
  --nsamples ${NSAMPLES} \
  --seed ${SEED} \
  --score_dir ${SCOREDIR}

log "Computing privacy importance scores"
srun python compute_importance_score.py \
  --model "${MODEL_LABEL}" \
  --model_path "${MODEL_PATH}" \
  --dataset beaver_train330k_privacy_safe_1k \
  --nsamples ${NSAMPLES} \
  --seed ${SEED} \
  --score_dir ${SCOREDIR}

log "Computing fairness importance scores"
srun python compute_importance_score.py \
  --model "${MODEL_LABEL}" \
  --model_path "${MODEL_PATH}" \
  --dataset beaver_train330k_fairness_safe_1k \
  --nsamples ${NSAMPLES} \
  --seed ${SEED} \
  --score_dir ${SCOREDIR}

log "Running SPIN + evaluation"
srun python main.py \
  --model "${MODEL_LABEL}" \
  --model_path "${MODEL_PATH}" \
  --dataset1 beaver_train330k_privacy_safe_1k \
  --dataset2 beaver_train330k_fairness_safe_1k \
  --target_module mlp \
  --p 5e-7 \
  --q 5e-7 \
  --nsamples ${NSAMPLES} \
  --seed ${SEED} \
  --score_dir ${SCOREDIR} \
  --model_dir ${MODELDIR} \
  --labels_out_dir "${LABELS_OUT_DIR}" \
| tee "${LOGDIR}/spin_eval_seed${SEED}.log"

log "DONE"
