#!/bin/bash

#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=SafetyHelp_DatasetReg_SmokeTest
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=00:20:00
#SBATCH --output=/home/aramautar1/fact-ai-group-23/src/jobs/safety_helpfulness_paired/outputs/SafetyHelp_DatasetReg_SmokeTest_%A.out

# Confirms "safety" and "helpfulness_train" are correctly registered in
# LlamaFactory/data/dataset_info.json and actually loadable/tokenizable by
# llamafactory.cli train -- not just that the JSON parses. Tiny LoRA run
# (max_samples 8, 1 epoch) on Qwen2-7B-Instruct; no merge/eval, this is only
# checking that dataset registration itself works.

set -euo pipefail
trap 'echo "[ERROR] Failed at line $LINENO: $BASH_COMMAND" >&2' ERR

module purge
module load 2025
module load Anaconda3/2025.06-1

CONDA_ROOT="/sw/arch/RHEL9/EB_production/2025/software/Anaconda3/2025.06-1"
source "$CONDA_ROOT/etc/profile.d/conda.sh"

conda info --envs | grep -q "LlFactory" || { echo "[ERROR] conda env LlFactory missing" >&2; exit 1; }

LLAMA_FACTORY_DIR="$HOME/fact-ai-group-23/LlamaFactory"
cd "$LLAMA_FACTORY_DIR"

conda run -n LlFactory bash -c "which python && python -V"

OUT_DIR="${TMPDIR}/dataset_reg_smoketest"
mkdir -p "${OUT_DIR}"

conda run -n LlFactory python -m llamafactory.cli train \
  --stage sft \
  --do_train True \
  --model_name_or_path "Qwen/Qwen2-7B-Instruct" \
  --finetuning_type lora \
  --template qwen \
  --trust_remote_code True \
  --dataset_dir data \
  --dataset safety,helpfulness_train \
  --max_samples 8 \
  --num_train_epochs 1 \
  --learning_rate 3e-4 \
  --per_device_train_batch_size 1 \
  --gradient_accumulation_steps 1 \
  --lora_rank 8 \
  --lora_alpha 16 \
  --bf16 True \
  --report_to none \
  --output_dir "${OUT_DIR}"

echo "[INFO] $(date '+%H:%M:%S') DONE -- both datasets loaded and training ran without error."
